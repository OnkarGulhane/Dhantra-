# Dhantra Backend Environment Configuration Template
SERVER_PORT=8080

# CORS Configuration (comma-separated origins or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (Replace with your actual database credentials in .env)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dhantra
DB_USER=your_db_username
DB_PASSWORD=your_db_password
