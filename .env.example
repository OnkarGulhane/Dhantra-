# Application Configuration Environment Variables Template
VITE_APP_NAME=Dhantra
VITE_API_BASE_URL=http://localhost:8080/api

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (Replace with your actual database credentials in .env)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dhantra
DB_USER=your_db_username
DB_PASSWORD=your_db_password
